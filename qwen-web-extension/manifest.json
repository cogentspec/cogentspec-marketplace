{
  "manifest_version": 3,
  "name": "CogentSpec Qwen Web Bridge",
  "version": "0.2.1",
  "description": "Start the local Bridge and deliver an authenticated Qwen Web work-area handoff when you send $qwenweb.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://qwen.ai/*", "https://*.qwen.ai/*", "https://cogentspec.app/stack*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "content_scripts": [{"matches": ["https://qwen.ai/*", "https://*.qwen.ai/*"], "all_frames": true, "run_at": "document_idle", "js": ["command.js"]}, {"matches":["https://cogentspec.app/stack*"],"run_at":"document_idle","js":["workspace.js"]}]
}
